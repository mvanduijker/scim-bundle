{
    "name": "mvanduijker/scim-bundle",
    "description": "Minimal SCIM 2.0 /Users endpoint for Microsoft Entra provisioning",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        { "name": "Mark van Duijker" }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": { "Duijker\\ScimBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Duijker\\ScimBundle\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
